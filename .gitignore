# Public for now: README, assets, benchmarks, and baselines. The SwarmEvolve code follows later.
/*
!/README.md
!/.gitignore
!/assets/
!/benchmarks/
!/baselines/
!/analysis/
/analysis/*
!/analysis/.gitkeep
# Security audit records and the approval-gated PoC verification pipeline (security/README.md).
!/security/
!/.oss-scanner/
!/.github/
# Codex integration (security/codex/DESIGN.md). Run directories such as .redteam-runs/ stay ignored.
!/AGENTS.md
!/.codex/
!/.agents/

results/
__pycache__/
*.egg-info/
.DS_Store
baselines/venv/
baselines/venv_codeevolve/
